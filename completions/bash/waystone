# shellcheck shell=bash
# shellcheck disable=SC2207

_waystone_completion() {
  local cur subcommand
  COMPREPLY=()
  cur="${COMP_WORDS[COMP_CWORD]}"
  subcommand="${COMP_WORDS[1]:-}"

  local subcommands="add capture import list pick select open remove rm prune edit relabel label note move mv help --help -h"
  local openers="nvim vim less bat jless jq wyrm py"

  if [[ $COMP_CWORD -eq 1 ]]; then
    COMPREPLY=( $(compgen -W "$subcommands $openers" -- "$cur") )
    return 0
  fi

  case "$subcommand" in
    add)
      if [[ $COMP_CWORD -eq 2 ]]; then
        COMPREPLY=( $(compgen -f -- "$cur") )
      fi
      ;;
    open)
      if [[ $COMP_CWORD -eq 2 ]]; then
        COMPREPLY=( $(compgen -W "$openers" -- "$cur") )
      else
        COMPREPLY=( $(compgen -f -- "$cur") )
      fi
      ;;
    select)
      if [[ $COMP_CWORD -eq 2 ]]; then
        COMPREPLY=( $(compgen -W "--action" -- "$cur") )
      fi
      ;;
    move|mv)
      COMPREPLY=( $(compgen -d -- "$cur") )
      ;;
    *)
      COMPREPLY=( $(compgen -f -- "$cur") )
      ;;
  esac
}

complete -F _waystone_completion waystone
