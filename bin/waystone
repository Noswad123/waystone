#!/usr/bin/env bash
set -euo pipefail

# Save, fuzzy-pick, copy, and open frequently used paths.

XDG_STATE_HOME="${XDG_STATE_HOME:-$HOME/.local/state}"
WAYSTONE_DIR="${WAYSTONE_DIR:-$XDG_STATE_HOME/waystone}"
WAYSTONE_FILE="${WAYSTONE_FILE:-$WAYSTONE_DIR/paths.tsv}"
WAYSTONE_PREVIEW='label={2}; path={3}; created={4}; note={5}; display_path=$path; case "$path" in "$HOME") display_path="~" ;; "$HOME"/*) display_path="~/${path#"$HOME"/}" ;; esac; cols=${FZF_PREVIEW_COLUMNS:-80}; case "$cols" in ""|*[!0-9]*) cols=80 ;; esac; [ "$cols" -gt 1 ] && cols=$((cols - 1)); sep=; i=0; while [ "$i" -lt "$cols" ]; do sep="${sep}-"; i=$((i + 1)); done; printf "Label: %s\nPath: %s\nCreated: %s\n" "$label" "$display_path" "$created"; [ -n "$note" ] && printf "Note: %s\n" "$note"; printf "\n%s\n" "$sep"; if [ -d "$path" ]; then /bin/ls -la "$path"; elif command -v bat >/dev/null 2>&1; then bat --style=numbers --color=always "$path"; else /bin/cat "$path"; fi'
WAYSTONE_COMMAND="$(basename "$0")"
WAYSTONE_OPEN_COMMANDS="${WAYSTONE_OPEN_COMMANDS:-nvim less bat yazi}"
WAYSTONE_DELIMITER=$'\t'
WAYSTONE_FZF_STYLE_ARGS=(
  --height=90%
  --layout=reverse
  --border=rounded
  --preview-border=rounded
  --info=inline-right
  --pointer='▶'
  --marker='✓'
)
WAYSTONE_FZF_PICKER_ARGS=(
  "${WAYSTONE_FZF_STYLE_ARGS[@]}"
  --border-label=' waystone '
  --preview-label=' metadata + preview '
  --prompt='waystone › '
)

mkdir -p "$WAYSTONE_DIR"
touch "$WAYSTONE_FILE"

usage() {
  cat <<EOF
Usage:
  $WAYSTONE_COMMAND [command...]            Fuzzy-pick a waystone and open it here
  $WAYSTONE_COMMAND add <path> [label]       Save a path with an optional label
  $WAYSTONE_COMMAND capture [label]          Save stdin to a temp file and mark it
  $WAYSTONE_COMMAND import                   Add newline-delimited paths from stdin
  $WAYSTONE_COMMAND list                     Print saved waystones
  $WAYSTONE_COMMAND pick                     Fuzzy-pick a waystone and copy its path
  $WAYSTONE_COMMAND open [command...]        Fuzzy-pick a waystone and open it here
                                   Without a command, fuzzy-pick an opener
  $WAYSTONE_COMMAND remove                   Fuzzy-select waystones to remove from registry
  $WAYSTONE_COMMAND prune                    Remove waystones whose paths no longer exist
  $WAYSTONE_COMMAND edit                     Open the TSV registry in \$EDITOR
  $WAYSTONE_COMMAND relabel [label]          Fuzzy-select a waystone and update its label
  $WAYSTONE_COMMAND note [note]              Fuzzy-select a waystone and update its note
  $WAYSTONE_COMMAND move <destination-dir>   Move selected path and update its waystone

Examples:
  $WAYSTONE_COMMAND add ~/notes/todo.md "todo"
  rg TODO . | $WAYSTONE_COMMAND capture "todo results"
  fd -e md . | $WAYSTONE_COMMAND import
  $WAYSTONE_COMMAND
  $WAYSTONE_COMMAND nvim
  $WAYSTONE_COMMAND pick
  $WAYSTONE_COMMAND open
  $WAYSTONE_COMMAND open less
  wisp $WAYSTONE_COMMAND
  wisp $WAYSTONE_COMMAND nvim
  wisp $WAYSTONE_COMMAND less
  $WAYSTONE_COMMAND remove
  $WAYSTONE_COMMAND relabel "better label"
  $WAYSTONE_COMMAND note "why this path matters"
  $WAYSTONE_COMMAND move ~/Notes/archive
EOF
}

notify() {
  local message="$1"
  osascript -e "display notification \"$message\" with title \"waystone\"" >/dev/null 2>&1 || true
}

resolve_path() {
  local path="$1"

  if [[ "$path" == ~* ]]; then
    path="${path/#\~/$HOME}"
  fi

  if [[ -d "$path" ]]; then
    (cd "$path" && pwd -P)
  elif [[ -e "$path" ]]; then
    local dir
    local base
    dir="$(dirname "$path")"
    base="$(basename "$path")"
    printf '%s/%s\n' "$(cd "$dir" && pwd -P)" "$base"
  else
    return 1
  fi
}

display_path() {
  local path="$1"
  if [[ "$path" == "$HOME"/* ]]; then
    printf '~/%s\n' "${path#"$HOME"/}"
  else
    printf '%s\n' "$path"
  fi
}

append_waystone() {
  local path="$1"
  local label="$2"
  local note="${3:-}"
  local created_at
  created_at="$(date '+%Y-%m-%dT%H:%M:%S%z')"

  printf '%s\t%s\t%s\t%s\n' "$label" "$path" "$created_at" "$note" >>"$WAYSTONE_FILE"
}

waystone_rows() {
  awk -F '\t' '{ label=$1; path=$2; created=$3; note=$4; if (label == "") label="(untitled)"; printf "%d\t%s\t%s\t%s\t%s\n", NR, label, path, created, note }' "$WAYSTONE_FILE"
}

select_waystone_path() {
  if [[ ! -s "$WAYSTONE_FILE" ]]; then
    printf 'waystone: no saved waystones\n' >&2
    return 1
  fi

  local selection
  selection="$(waystone_rows \
    | fzf "${WAYSTONE_FZF_PICKER_ARGS[@]}" --delimiter="$WAYSTONE_DELIMITER" --with-nth=2 --preview="$WAYSTONE_PREVIEW" --preview-window='right:60%:wrap' \
    || true)"

  if [[ -z "$selection" ]]; then
    return 1
  fi

  printf '%s\n' "$selection" | cut -f3
}

select_waystone_rows() {
  local multi="${1:-no}"

  if [[ ! -s "$WAYSTONE_FILE" ]]; then
    printf 'waystone: no saved waystones\n' >&2
    return 1
  fi

  local fzf_args=("${WAYSTONE_FZF_PICKER_ARGS[@]}" --delimiter="$WAYSTONE_DELIMITER" --with-nth=2 --preview="$WAYSTONE_PREVIEW" --preview-window='right:60%:wrap')
  if [[ "$multi" == "yes" ]]; then
    fzf_args+=(--multi)
  fi

  waystone_rows | fzf "${fzf_args[@]}" || true
}

select_open_command() {
  local selection
  selection="$(printf '%s\n' $WAYSTONE_OPEN_COMMANDS | fzf "${WAYSTONE_FZF_STYLE_ARGS[@]}" --border-label=' open with ' --prompt='open with › ' || true)"

  if [[ -z "$selection" ]]; then
    return 1
  fi

  printf '%s\n' "$selection"
}

remove_line_numbers() {
  local tmp
  tmp="$(mktemp)"

  awk -F '\t' 'NR == FNR { remove[$1] = 1; next } !(FNR in remove)' "$1" "$WAYSTONE_FILE" >"$tmp"
  mv "$tmp" "$WAYSTONE_FILE"
}

cmd_add() {
  if [[ $# -lt 1 ]]; then
    usage >&2
    return 1
  fi

  local path
  local label
  path="$(resolve_path "$1")"
  label="${2:-$(display_path "$path")}"

  append_waystone "$path" "$label"
  printf 'Marked: %s -> %s\n' "$label" "$path"
}

cmd_capture() {
  local label="${1:-capture}"
  local path
  local content
  local candidate
  local resolved_path
  path="$WAYSTONE_DIR/captures/$(date '+%Y%m%d-%H%M%S').txt"

  if [[ -t 0 ]]; then
    content="$(pbpaste 2>/dev/null || true)"
    candidate="${content%%$'\n'*}"

    if [[ -n "$candidate" ]] && resolved_path="$(resolve_path "$candidate" 2>/dev/null)"; then
      append_waystone "$resolved_path" "$label"
      printf 'Marked clipboard path: %s -> %s\n' "$label" "$resolved_path"
      return
    fi

    mkdir -p "$(dirname "$path")"
    printf '%s' "$content" >"$path"
  else
    mkdir -p "$(dirname "$path")"
    cat >"$path"
  fi

  append_waystone "$path" "$label"
  printf 'Captured: %s -> %s\n' "$label" "$path"
}

cmd_import() {
  local imported=0
  local skipped=0
  local raw_path
  local path
  local label

  while IFS= read -r raw_path; do
    [[ -z "$raw_path" ]] && continue

    if path="$(resolve_path "$raw_path" 2>/dev/null)"; then
      label="$(display_path "$path")"
      append_waystone "$path" "$label"
      imported=$((imported + 1))
    else
      printf 'waystone: skipped missing path: %s\n' "$raw_path" >&2
      skipped=$((skipped + 1))
    fi
  done

  printf 'Imported: %d marked, %d skipped\n' "$imported" "$skipped"
}

cmd_list() {
  if [[ ! -s "$WAYSTONE_FILE" ]]; then
    return 0
  fi

  awk -F '\t' '{ printf "%s\t%s\t%s\t%s\n", $1, $2, $3, $4 }' "$WAYSTONE_FILE"
}

cmd_pick() {
  local path
  path="$(select_waystone_path)"

  printf '%s\n' "$path" | pbcopy
  printf '%s\n' "$path"
  notify "Copied path to clipboard"
}

cmd_open() {
  local path
  local opener
  path="$(select_waystone_path)"

  if [[ $# -eq 0 ]]; then
    opener="$(select_open_command)"
    set -- "$opener"
  fi

  exec "$@" "$path"
}

cmd_remove() {
  local selection
  local numbers
  local numbers_file
  local count

  selection="$(select_waystone_rows yes)"
  [[ -z "$selection" ]] && return 1

  numbers="$(printf '%s\n' "$selection" | cut -f1)"
  numbers_file="$(mktemp)"
  printf '%s\n' "$numbers" >"$numbers_file"
  count="$(printf '%s\n' "$numbers" | wc -l | tr -d ' ')"

  remove_line_numbers "$numbers_file"
  rm -f "$numbers_file"

  printf 'Removed %s waystone(s)\n' "$count"
}

cmd_prune() {
  local tmp
  local removed
  tmp="$(mktemp)"

  awk -F '\t' 'BEGIN { removed=0 } { if (system("test -e \"" $2 "\"") == 0) print $0; else removed++ } END { print removed > "/dev/stderr" }' "$WAYSTONE_FILE" >"$tmp" 2>"$tmp.removed"
  removed="$(cat "$tmp.removed")"
  mv "$tmp" "$WAYSTONE_FILE"
  rm -f "$tmp.removed"

  printf 'Pruned %s missing waystone(s)\n' "$removed"
}

cmd_edit() {
  "${EDITOR:-nvim}" "$WAYSTONE_FILE"
}

cmd_relabel() {
  local new_label="${1:-}"
  local selection
  local line_number
  local tmp

  selection="$(select_waystone_rows no)"
  [[ -z "$selection" ]] && return 1

  line_number="$(printf '%s\n' "$selection" | cut -f1)"

  if [[ -z "$new_label" ]]; then
    printf 'New label: '
    IFS= read -r new_label
  fi

  tmp="$(mktemp)"
  awk -F '\t' -v OFS='\t' -v line="$line_number" -v label="$new_label" 'FNR == line { $1 = label } { print }' "$WAYSTONE_FILE" >"$tmp"
  mv "$tmp" "$WAYSTONE_FILE"

  printf 'Relabeled waystone %s -> %s\n' "$line_number" "$new_label"
}

cmd_note() {
  local new_note="${1:-}"
  local selection
  local line_number
  local tmp

  selection="$(select_waystone_rows no)"
  [[ -z "$selection" ]] && return 1

  line_number="$(printf '%s\n' "$selection" | cut -f1)"

  if [[ -z "$new_note" ]]; then
    printf 'New note: '
    IFS= read -r new_note
  fi

  tmp="$(mktemp)"
  awk -F '\t' -v OFS='\t' -v line="$line_number" -v note="$new_note" 'FNR == line { $4 = note } { print }' "$WAYSTONE_FILE" >"$tmp"
  mv "$tmp" "$WAYSTONE_FILE"

  printf 'Updated note for waystone %s\n' "$line_number"
}

cmd_move() {
  if [[ $# -lt 1 ]]; then
    usage >&2
    return 1
  fi

  local destination_dir
  local selection
  local line_number
  local old_path
  local new_path
  local tmp

  destination_dir="$(resolve_path "$1")"
  if [[ ! -d "$destination_dir" ]]; then
    printf 'waystone: destination is not a directory: %s\n' "$1" >&2
    return 1
  fi

  selection="$(select_waystone_rows no)"
  [[ -z "$selection" ]] && return 1

  line_number="$(printf '%s\n' "$selection" | cut -f1)"
  old_path="$(printf '%s\n' "$selection" | cut -f3)"
  new_path="$destination_dir/$(basename "$old_path")"

  if [[ -e "$new_path" ]]; then
    printf 'waystone: destination already exists: %s\n' "$new_path" >&2
    return 1
  fi

  mv "$old_path" "$new_path"

  tmp="$(mktemp)"
  awk -F '\t' -v OFS='\t' -v line="$line_number" -v path="$new_path" 'FNR == line { $2 = path } { print }' "$WAYSTONE_FILE" >"$tmp"
  mv "$tmp" "$WAYSTONE_FILE"

  printf 'Moved: %s -> %s\n' "$old_path" "$new_path"
}

command_resolves() {
  local command="$1"
  command -v "$command" >/dev/null 2>&1 || [[ -x "$command" ]]
}

main() {
  local command="${1:-}"

  case "$command" in
    '') cmd_open ;;
    add) shift; cmd_add "$@" ;;
    capture) shift; cmd_capture "$@" ;;
    import) shift; cmd_import "$@" ;;
    list) shift; cmd_list "$@" ;;
    pick) shift; cmd_pick "$@" ;;
    open) shift; cmd_open "$@" ;;
    remove|rm) shift; cmd_remove "$@" ;;
    prune) shift; cmd_prune "$@" ;;
    edit) shift; cmd_edit "$@" ;;
    relabel|label) shift; cmd_relabel "$@" ;;
    note) shift; cmd_note "$@" ;;
    move|mv) shift; cmd_move "$@" ;;
    -h|--help|help) usage ;;
    *)
      if command_resolves "$command"; then
        shift
        cmd_open "$command" "$@"
      else
        printf 'waystone: unknown command or opener: %s\n' "$command" >&2
        usage >&2
        return 1
      fi
      ;;
  esac
}

main "$@"
